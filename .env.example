# ==============================================================================
# Kraken Admin Tool - Environment Variables
# ==============================================================================

# Database Configuration (PostgreSQL)
DB_HOST=postgres
DB_PORT=5432
DB_USER=kraken
DB_PASSWORD=replace_with_a_secure_db_password
DB_NAME=kraken_db

# Backend Configuration
PORT=8080
ENVIRONMENT=production
# Generate with: openssl rand -base64 32
JWT_SECRET=replace_with_a_random_jwt_secret_at_least_32_bytes!
# Optional 32-byte key for AES-256-GCM encryption of stored host credentials (defaults to hash of JWT_SECRET)
ENCRYPTION_KEY=
# Explicit admin password for initial bootstrap in production
INITIAL_ADMIN_PASSWORD=
DOCKER_HOST=unix:///var/run/docker.sock
KUBECONFIG=/home/kraken/.kube/config
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8080
INTERNAL_API_URL=http://backend:8080

