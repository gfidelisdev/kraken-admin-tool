# ==============================================================================
# Kraken Admin Tool - Root Environment Variables (.env.example)
# ==============================================================================
# Copy this file to `.env` (and optionally `backend/.env` / `frontend/.env`)
# and fill in strong, unique values before starting the stack.
# `.env` files are git-ignored; never commit real secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database Configuration (PostgreSQL)
# ------------------------------------------------------------------------------
DB_HOST=postgres
DB_PORT=5432
DB_USER=kraken
# Generate with: openssl rand -base64 24
DB_PASSWORD=replace_with_a_strong_database_password
DB_NAME=kraken_db
DB_SSLMODE=disable

# ------------------------------------------------------------------------------
# 2. Backend Security & Cryptographic Secrets (REQUIRED)
# ------------------------------------------------------------------------------
PORT=8080
ENVIRONMENT=production

# REQUIRED: 32+ byte secret used to sign & verify HS256 JWT tokens.
# Generate with: openssl rand -base64 48
JWT_SECRET=replace_with_a_unique_random_jwt_secret_at_least_32_bytes

# REQUIRED: Independent 32+ byte master key used for AES-256-GCM encryption of
# stored SSH keys, passwords, and TLS certificates at rest in the database.
# Generate with: openssl rand -base64 48
ENCRYPTION_KEY=replace_with_a_unique_random_encryption_key_at_least_32_bytes

# OPTIONAL: Comma-separated list of previous encryption keys for zero-downtime key rotation
# of existing encrypted database rows (SSH credentials, TLS keys, TOTP secrets).
ENCRYPTION_KEY_PREVIOUS=

# OPTIONAL: Dedicated emergency key for POST /api/auth/admin-recovery (X-Master-Key).
# Leave empty to keep HTTP admin-recovery DISABLED (recommended; use CLI recovery instead).
# If enabled, must be at least 32 characters and distinct from JWT_SECRET.
# Generate with: openssl rand -base64 48
ADMIN_RECOVERY_KEY=

# OPTIONAL: Explicit admin password for initial database bootstrap (only used when no admin exists).
INITIAL_ADMIN_PASSWORD=

# OPTIONAL: Comma-separated list of trusted reverse-proxy IPs or CIDRs allowed
# to supply X-Forwarded-For / X-Real-IP headers (empty = trust RemoteAddr only).
TRUSTED_PROXIES=

# ------------------------------------------------------------------------------
# 3. Runtime & Integrations
# ------------------------------------------------------------------------------
DOCKER_HOST=unix:///var/run/docker.sock
KUBECONFIG=/home/kraken/.kube/config
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
ALLOW_REGISTRATION=false
PLUGINS_DIR=/app/data/plugins

# ------------------------------------------------------------------------------
# 4. Frontend Configuration (Next.js)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8080
INTERNAL_API_URL=http://backend:8080
NEXT_PUBLIC_AUTH_TOKEN_STORAGE_KEY=kraken_auth_token
NEXT_PUBLIC_ACTIVE_SERVER_STORAGE_KEY=kraken_active_server_id
