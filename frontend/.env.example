# ==============================================================================
# Kraken Admin Tool - Frontend Local Environment (.env.example)
# ==============================================================================
# Copy to `frontend/.env.local` or `frontend/.env` when running `npm run dev`.

NEXT_PUBLIC_API_URL=http://localhost:8080
INTERNAL_API_URL=http://localhost:8080
NEXT_PUBLIC_AUTH_TOKEN_STORAGE_KEY=kraken_auth_token
NEXT_PUBLIC_ACTIVE_SERVER_STORAGE_KEY=kraken_active_server_id
