# ==============================================================================
# Kraken Admin Tool - Backend Local Environment (.env.example)
# ==============================================================================
# Copy to `backend/.env` when running `go run ./cmd/server` directly on the host.

PORT=8080
ENVIRONMENT=development

DB_HOST=localhost
DB_PORT=5432
DB_USER=kraken
DB_PASSWORD=replace_with_a_strong_database_password
DB_NAME=kraken_db
DB_SSLMODE=disable

# Generate with: openssl rand -base64 48
JWT_SECRET=replace_with_a_unique_random_jwt_secret_at_least_32_bytes
ENCRYPTION_KEY=replace_with_a_unique_random_encryption_key_at_least_32_bytes
ENCRYPTION_KEY_PREVIOUS=

# Leave empty to keep HTTP /api/auth/admin-recovery disabled
ADMIN_RECOVERY_KEY=
INITIAL_ADMIN_PASSWORD=
TRUSTED_PROXIES=

DOCKER_HOST=unix:///var/run/docker.sock
KUBECONFIG=
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
ALLOW_REGISTRATION=false
PLUGINS_DIR=./data/plugins
